{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai": {
      "root": "ai",
      "framework": "fastapi"
    },
    "server": {
      "root": "server",
      "framework": "nestjs",
      "bindings": [
        {
          "type": "service",
          "service": "ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
